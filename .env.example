# OpenAI - Script generation
OPENAI_API_KEY=your_openai_api_key_here

# ElevenLabs - Text-to-speech
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Image generation (use one or both)
LEONARDO_API_KEY=your_leonardo_api_key_here
MIDJOURNEY_API_KEY=your_midjourney_api_key_here

# Portrait Animation APIs (for Talking Head mode - use one or both)
# Replicate uses SadTalker model for audio-driven lip-sync
HEDRA_API_KEY=your_hedra_api_key_here
REPLICATE_API_TOKEN=your_replicate_api_token_here

# Persona settings (talking head mode)
PERSONAS_DIR=assets/personas
USE_PERSONA=false
DEFAULT_PERSONA=

# Mascot settings (optional - for visual branding consistency)
MASCOT_ENABLED=true
MASCOT_PROMPT=A cute, futuristic robot with glowing blue eyes and a cracked screen, vector art style
IMAGE_STYLE=vector art style, vibrant colors, clean lines

# Background music settings (optional)
MUSIC_ENABLED=true
MUSIC_DIR=assets/music
MUSIC_VOLUME=0.1
VOICE_VOLUME=1.0
