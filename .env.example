# Required
OPENAI_API_KEY=sk-...

# Recommended
ELEVENLABS_API_KEY=...
REPLICATE_API_TOKEN=r8_...

# Optional (talking head mode)
HEDRA_API_KEY=...

# V2 Settings (all have defaults, override if needed)
# FLUX_MODEL=black-forest-labs/flux-1.1-pro
# MINIMAX_MODEL=minimax/image-to-video
# ELEVENLABS_MODEL=eleven_multilingual_v2
# ELEVENLABS_VOICE_ID=pqHfZKP75CvOlQylNhV4  # Bill (default)
# SUBTITLE_STYLE=bold_impact
# CROSSFADE_DURATION=0.8
# ENABLE_SFX=true
# ENABLE_MOTION=true
# MAX_PARALLEL_WORKERS=3
# NICHE=tech
# REDDIT_SUBREDDITS=todayilearned,technology,science,explainlikeimfive

# YouTube (optional)
# YOUTUBE_CLIENT_SECRETS=client_secrets.json
# YOUTUBE_TOKEN_PATH=youtube_token.json
# YOUTUBE_PRIVACY=public
# YOUTUBE_API_KEY=AIza...  # For auto-fetching video stats (no OAuth needed)

# Shot editor (all have defaults; uncomment to override)
# Cut rhythm: calm | standard | fast
# PACING=standard
# true = fail the run instead of shipping a still shot
# STRICT=false
# Background music: mine | generated | any | none
# MUSIC_SOURCE=any
# ElevenLabs music model used by --build-music-library
# ELEVENLABS_MUSIC_MODEL=music_v1
# USD per minute of generated music / SFX (cost log)
# COST_ELEVENLABS_MUSIC_PER_MINUTE=0.15
# COST_ELEVENLABS_SFX_PER_MINUTE=0.12
# Whisper model for word timing (base is lighter)
# WHISPER_MODEL=small
# Parallel motion-clip generations
# MOTION_CONCURRENCY=4
# Prune output/<job>/sources older than this many days (<= 0 disables)
# KEEP_SOURCES_DAYS=14
# Fallback fal video model, e.g. kling (empty = none)
# FAL_VIDEO_FALLBACK_MODEL=
