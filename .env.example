# Required for OpenAI TTS fallback / LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...

# Script LLM (all have defaults). Providers: claude_cli (Claude Code, headless) | codex (OpenAI Codex CLI,
# headless) | openai (paid API). LLM_FALLBACK is tried in order when the provider fails; none = no fallback.
# LLM_PROVIDER=claude_cli
# LLM_FALLBACK=codex,openai
# CLAUDE_CLI_MODEL=sonnet
# Codex model; empty = the Codex CLI default (a ChatGPT login rejects most names; gpt-5.5 works)
# CODEX_MODEL=gpt-5.5
# Codex reasoning effort (none|low|medium|high|xhigh); empty = the Codex config value
# CODEX_REASONING_EFFORT=medium
# OPENAI_MODEL=gpt-5.4-mini-2026-03-17
# Seconds per Codex call
# CODEX_CLI_TIMEOUT=300
# Claude CLI auth (Docker/VPS): a long-lived token from `claude setup-token` uses your Claude subscription.
# Leave ANTHROPIC_API_KEY unset unless you want API billing: the CLI prefers it over the token.
# CLAUDE_CODE_OAUTH_TOKEN=
# Codex CLI auth: `codex login` on the host (ChatGPT plan; docker-compose mounts ~/.codex), or an API key:
# CODEX_API_KEY=

# Recommended
ELEVENLABS_API_KEY=...
REPLICATE_API_TOKEN=r8_...

# Optional (talking head mode)
HEDRA_API_KEY=...

# V2 Settings (all have defaults, override if needed)
# FLUX_MODEL=black-forest-labs/flux-1.1-pro
# MINIMAX_MODEL=minimax/image-to-video
# ELEVENLABS_MODEL=eleven_multilingual_v2
# ELEVENLABS_VOICE_ID=pqHfZKP75CvOlQylNhV4  # Bill (default)
# SUBTITLE_STYLE=bold_impact
# CROSSFADE_DURATION=0.8
# ENABLE_SFX=true
# ENABLE_MOTION=true
# MAX_PARALLEL_WORKERS=3
# NICHE=tech
# REDDIT_SUBREDDITS=todayilearned,technology,science,explainlikeimfive

# YouTube (optional)
# YOUTUBE_CLIENT_SECRETS=client_secrets.json
# YOUTUBE_TOKEN_PATH=youtube_token.json
# YOUTUBE_PRIVACY=public
# YOUTUBE_API_KEY=AIza...  # For auto-fetching video stats (no OAuth needed)

# Shot editor (all have defaults; uncomment to override)
# Cut rhythm: calm | standard | fast
# PACING=standard
# true = fail the run instead of shipping a still shot
# STRICT=false
# Background music: mine | generated | any | none
# MUSIC_SOURCE=any
# ElevenLabs music model used by --build-music-library
# ELEVENLABS_MUSIC_MODEL=music_v1
# USD per minute of generated music / SFX (cost log)
# COST_ELEVENLABS_MUSIC_PER_MINUTE=0.15
# COST_ELEVENLABS_SFX_PER_MINUTE=0.12
# Whisper model for word timing (base is lighter)
# WHISPER_MODEL=small
# Parallel motion-clip generations
# MOTION_CONCURRENCY=4
# Prune output/<job>/sources older than this many days (<= 0 disables)
# KEEP_SOURCES_DAYS=14
# Fallback fal video model, e.g. kling (empty = none)
# FAL_VIDEO_FALLBACK_MODEL=

# Quality tiers (motion model per video): standard (Kling v3 Standard) | premium (Kling v3 Pro) |
# custom (FAL_VIDEO_MODEL: kling | kling-pro | hailuo | h3-turbo | h3)
# QUALITY_TIER=standard
# Per-video spending cap in USD; the run stops before the next paid stage when the estimate is higher (0 = no cap)
# MAX_COST_PER_VIDEO=0
